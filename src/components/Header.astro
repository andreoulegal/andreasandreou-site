---
import { getPublishedNavigation } from '../lib/siteContent';

const navigation = await getPublishedNavigation();
---

<header class="site-header wrap">
  <a class="wordmark" href="/">Andreas Andreou</a>
  <nav class="nav" aria-label="Primary">
    {navigation.map((item) => (
      <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
  <a class="contact" href="/#contact">Contact</a>
</header>
