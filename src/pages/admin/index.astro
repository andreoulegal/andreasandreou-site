---
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://andreasandreou-site.netlify.app';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const anonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Articles dashboard — Andreas Andreou</title>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <main class="admin-shell">
      <section id="login-panel" class="admin-card">
        <p class="eyebrow">Private workspace</p>
        <h1>Articles dashboard</h1>
        <p>Sign in with your administrator email to manage articles.</p>
        <form id="login-form">
          <label for="email">Email</label>
          <input id="email" type="email" value="andreoulegal@gmail.com" required />
          <button class="button" type="submit">Send sign-in link</button>
          <p id="login-message" class="form-message" role="status"></p>
        </form>
      </section>

      <section id="dashboard-panel" class="admin-card" hidden>
        <div class="admin-heading">
          <div><p class="eyebrow">Private workspace</p><h1>Articles</h1></div>
          <button id="sign-out" class="text-link" type="button">Sign out</button>
        </div>
        <p id="user-email" class="muted"></p>

        <form id="article-form" class="article-form">
          <input id="article-id" type="hidden" />
          <label for="title">Title</label><input id="title" required />
          <label for="slug">Slug</label><input id="slug" required pattern="[a-z0-9-]+" placeholder="my-article" />
          <label for="excerpt">Excerpt</label><textarea id="excerpt" rows="3"></textarea>
          <label for="body">Body (JSON for now)</label>
          <textarea id="body" rows="7" placeholder="JSON document">&#123;&quot;type&quot;:&quot;doc&quot;,&quot;content&quot;:[]&#125;</textarea>
          <label for="cover-image">Cover image</label><input id="cover-image" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
          <label for="status">Status</label><select id="status"><option value="draft">Draft</option><option value="published">Published</option><option value="archived">Archived</option></select>
          <div class="form-actions"><button id="save-article" class="button" type="submit">Save article</button><button id="cancel-edit" class="text-link" type="button" hidden>Cancel edit</button></div>
          <p id="article-message" class="form-message" role="status"></p>
        </form>

        <h2>Saved articles</h2><div id="articles-list" class="admin-list"></div>
      </section>
    </main>

    <script type="module" define:vars={{ siteUrl, supabaseUrl, anonKey }}>
      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      const supabase = createClient(supabaseUrl, anonKey, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
      const $ = (selector) => document.querySelector(selector);
      const loginPanel = $('#login-panel'); const dashboardPanel = $('#dashboard-panel'); const loginMessage = $('#login-message'); const articleMessage = $('#article-message'); const list = $('#articles-list');
      let currentUser = null;

      const resetForm = () => { $('#article-form').reset(); $('#article-id').value = ''; $('#save-article').textContent = 'Save article'; $('#cancel-edit').hidden = true; $('#body').value = '{"type":"doc","content":[]}'; };
      const renderArticles = (articles) => {
        list.replaceChildren();
        if (!articles.length) { const empty = document.createElement('p'); empty.className = 'muted'; empty.textContent = 'No articles yet.'; list.append(empty); return; }
        for (const article of articles) {
          const row = document.createElement('article'); const title = document.createElement('strong'); title.textContent = article.title; const meta = document.createElement('span'); meta.textContent = `${article.status} · /${article.slug}`; const edit = document.createElement('button'); edit.className = 'text-link'; edit.type = 'button'; edit.textContent = 'Edit'; edit.addEventListener('click', () => fillForm(article)); const remove = document.createElement('button'); remove.className = 'danger-link'; remove.type = 'button'; remove.textContent = 'Delete'; remove.addEventListener('click', () => deleteArticle(article)); const actions = document.createElement('div'); actions.className = 'row-actions'; actions.append(edit, remove); row.append(title, meta, actions); list.append(row);
        }
      };
      const loadArticles = async () => { const { data, error } = await supabase.from('articles').select('id,title,slug,excerpt,body,status,cover_image_path,updated_at').eq('author_id', currentUser.id).order('updated_at', { ascending: false }); if (error) { list.textContent = error.message; return; } renderArticles(data); };
      const fillForm = (article) => { $('#article-id').value = article.id; $('#title').value = article.title; $('#slug').value = article.slug; $('#excerpt').value = article.excerpt || ''; $('#body').value = JSON.stringify(article.body || { type: 'doc', content: [] }, null, 2); $('#status').value = article.status; $('#save-article').textContent = 'Update article'; $('#cancel-edit').hidden = false; window.scrollTo({ top: 0, behavior: 'smooth' }); };
      const deleteArticle = async (article) => { if (!window.confirm(`Delete “${article.title}”?`)) return; const { error } = await supabase.from('articles').delete().eq('id', article.id).eq('author_id', currentUser.id); articleMessage.textContent = error ? error.message : 'Article deleted.'; if (!error) await loadArticles(); };
      const uploadCover = async (file) => { if (!file) return null; if (file.size > 5 * 1024 * 1024) throw new Error('The image must be smaller than 5 MB.'); const safeName = file.name.toLowerCase().replace(/[^a-z0-9.]+/g, '-'); const path = `${currentUser.id}/${crypto.randomUUID()}-${safeName}`; const { error } = await supabase.storage.from('article-media').upload(path, file, { contentType: file.type, upsert: false }); if (error) throw error; const { data } = supabase.storage.from('article-media').getPublicUrl(path); return data.publicUrl; };
      const showSession = async (session) => { currentUser = session?.user || null; loginPanel.hidden = Boolean(currentUser); dashboardPanel.hidden = !currentUser; if (currentUser) { $('#user-email').textContent = currentUser.email; await loadArticles(); } };

      $('#login-form').addEventListener('submit', async (event) => { event.preventDefault(); loginMessage.textContent = 'Sending…'; const { error } = await supabase.auth.signInWithOtp({ email: $('#email').value, options: { emailRedirectTo: `${siteUrl}/auth/callback` } }); loginMessage.textContent = error ? error.message : 'Check your email for the sign-in link.'; });
      $('#sign-out').addEventListener('click', async () => { await supabase.auth.signOut(); resetForm(); await showSession(null); });
      $('#cancel-edit').addEventListener('click', () => { resetForm(); articleMessage.textContent = ''; });
      $('#article-form').addEventListener('submit', async (event) => { event.preventDefault(); articleMessage.textContent = 'Saving…'; try { let body; try { body = JSON.parse($('#body').value); } catch { throw new Error('Body must be valid JSON.'); } const coverUrl = await uploadCover($('#cover-image').files[0]); const status = $('#status').value; const payload = { title: $('#title').value, slug: $('#slug').value, excerpt: $('#excerpt').value, body, status, published_at: status === 'published' ? new Date().toISOString() : null }; if (coverUrl) payload.cover_image_path = coverUrl; const id = $('#article-id').value; const result = id ? await supabase.from('articles').update(payload).eq('id', id).eq('author_id', currentUser.id) : await supabase.from('articles').insert({ ...payload, author_id: currentUser.id }); if (result.error) throw result.error; articleMessage.textContent = id ? 'Article updated.' : 'Article saved.'; resetForm(); await loadArticles(); } catch (error) { articleMessage.textContent = error.message; } });
      supabase.auth.onAuthStateChange((_event, session) => showSession(session)); const { data: { session } } = await supabase.auth.getSession(); await showSession(session);
    </script>
  </body>
</html>
