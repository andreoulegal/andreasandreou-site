---
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const anonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Articles dashboard — Andreas Andreou</title>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <main class="admin-shell">
      <section id="dashboard-panel" class="admin-card">
        <div class="admin-heading">
          <div><p class="eyebrow">Private workspace</p><h1>Articles</h1></div>
          <button id="sign-out" class="text-link" type="button">Sign out</button>
        </div>
        <p id="user-email" class="muted"></p>

        <form id="article-form" class="article-form">
          <input id="article-id" type="hidden" />
          <label for="title">Title</label><input id="title" required />
          <label for="slug">Slug</label><input id="slug" required pattern="[a-z0-9-]+" placeholder="my-article" />
          <label for="excerpt">Excerpt</label><textarea id="excerpt" rows="3"></textarea>
          <label for="category">Category</label><input id="category" placeholder="Public life" />
          <label>Body</label>
          <div class="editor-toolbar" role="toolbar" aria-label="Formatting">
            <button type="button" data-command="bold"><strong>B</strong></button><button type="button" data-command="italic"><em>I</em></button><button type="button" data-command="formatBlock" data-value="h2">H2</button><button type="button" data-command="insertUnorderedList">• List</button><button type="button" data-command="createLink">Link</button>
          </div>
          <div id="editor" class="rich-editor" contenteditable="true" role="textbox" aria-multiline="true"></div>
          <label for="cover-image">Cover image</label><input id="cover-image" type="file" accept="image/jpeg,image/png,image/webp,image/gif" /><input id="cover-url" type="url" placeholder="Or paste a cover image URL" />
          <label for="status">Status</label><select id="status"><option value="draft">Draft</option><option value="published">Published</option><option value="archived">Archived</option></select>
          <div class="form-actions"><button id="save-article" class="button" type="submit">Save article</button><button id="cancel-edit" class="text-link" type="button" hidden>Cancel edit</button></div>
          <p id="article-message" class="form-message" role="status"></p>
        </form>

        <h2>Saved articles</h2><div id="articles-list" class="admin-list"></div>
      </section>
    </main>

    <script type="application/json" id="admin-config" set:html={JSON.stringify({ supabaseUrl, anonKey })}></script>
    <script type="module" is:inline>
      const { supabaseUrl, anonKey } = JSON.parse(document.querySelector('#admin-config').textContent);
      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      const supabase = createClient(supabaseUrl, anonKey, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
      const $ = (selector) => document.querySelector(selector);
      const articleMessage = $('#article-message'); const list = $('#articles-list');
      let currentUser = null;

      const resetForm = () => { $('#article-form').reset(); $('#article-id').value = ''; $('#save-article').textContent = 'Save article'; $('#cancel-edit').hidden = true; $('#editor').innerHTML = '<p><br></p>'; };
      const bodyToHtml = (body) => { const blocks = Array.isArray(body?.content) ? body.content : []; return blocks.map((block) => { const text = (node) => node?.text || (node?.content || []).map(text).join(''); const value = text(block).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;'); return block.type === 'heading' ? `<h2>${value}</h2>` : block.type === 'listItem' ? `<li>${value}</li>` : `<p>${value}</p>`; }).join('') || '<p><br></p>'; };
      const editorToBody = () => { const nodes = [...$('#editor').children]; const source = nodes.length ? nodes : [$('#editor')]; return { type: 'doc', content: source.flatMap((node) => { const text = node.textContent?.trim() || ''; if (!text) return []; const type = node.tagName === 'H2' ? 'heading' : node.tagName === 'LI' ? 'listItem' : 'paragraph'; return [{ type, content: [{ text }] }]; }) }; };
      const renderArticles = (articles) => {
        list.replaceChildren();
        if (!articles.length) { const empty = document.createElement('p'); empty.className = 'muted'; empty.textContent = 'No articles yet.'; list.append(empty); return; }
        for (const article of articles) {
          const row = document.createElement('article'); const title = document.createElement('strong'); title.textContent = article.title; const meta = document.createElement('span'); meta.textContent = `${article.status} · /${article.slug}`; const edit = document.createElement('button'); edit.className = 'text-link'; edit.type = 'button'; edit.textContent = 'Edit'; edit.addEventListener('click', () => fillForm(article)); const remove = document.createElement('button'); remove.className = 'danger-link'; remove.type = 'button'; remove.textContent = 'Delete'; remove.addEventListener('click', () => deleteArticle(article)); const actions = document.createElement('div'); actions.className = 'row-actions'; actions.append(edit, remove); row.append(title, meta, actions); list.append(row);
        }
      };
      const loadArticles = async () => { const { data, error } = await supabase.from('articles').select('id,title,slug,excerpt,body,category,status,cover_image_path,updated_at').eq('author_id', currentUser.id).order('updated_at', { ascending: false }); if (error) { list.textContent = error.message; return; } renderArticles(data); };
      const fillForm = (article) => { $('#article-id').value = article.id; $('#title').value = article.title; $('#slug').value = article.slug; $('#excerpt').value = article.excerpt || ''; $('#category').value = article.category || ''; $('#cover-url').value = article.cover_image_path || ''; $('#editor').innerHTML = bodyToHtml(article.body); $('#status').value = article.status; $('#save-article').textContent = 'Update article'; $('#cancel-edit').hidden = false; window.scrollTo({ top: 0, behavior: 'smooth' }); };
      const deleteArticle = async (article) => { if (!window.confirm(`Delete “${article.title}”?`)) return; const { error } = await supabase.from('articles').delete().eq('id', article.id).eq('author_id', currentUser.id); articleMessage.textContent = error ? error.message : 'Article deleted.'; if (!error) await loadArticles(); };
      const uploadCover = async (file) => { if (!file) return null; if (file.size > 5 * 1024 * 1024) throw new Error('The image must be smaller than 5 MB.'); const safeName = file.name.toLowerCase().replace(/[^a-z0-9.]+/g, '-'); const path = `${currentUser.id}/${crypto.randomUUID()}-${safeName}`; const { error } = await supabase.storage.from('article-media').upload(path, file, { contentType: file.type, upsert: false }); if (error) throw error; const { data } = supabase.storage.from('article-media').getPublicUrl(path); return data.publicUrl; };
      const showSession = async (session) => { currentUser = session?.user || null; if (!currentUser) { window.location.replace('/admin/login'); return; } $('#user-email').textContent = currentUser.email; await loadArticles(); };

      $('#sign-out').addEventListener('click', async () => { await supabase.auth.signOut(); resetForm(); await showSession(null); });
      $('#cancel-edit').addEventListener('click', () => { resetForm(); articleMessage.textContent = ''; });
      document.querySelectorAll('[data-command]').forEach((button) => button.addEventListener('click', () => { const command = button.dataset.command; if (command === 'createLink') { const url = window.prompt('Link URL'); if (url) document.execCommand(command, false, url); } else document.execCommand(command, false, button.dataset.value || null); $('#editor').focus(); }));
      $('#article-form').addEventListener('submit', async (event) => { event.preventDefault(); articleMessage.textContent = 'Saving…'; try { const body = editorToBody(); const uploadedUrl = await uploadCover($('#cover-image').files[0]); const coverUrl = uploadedUrl || $('#cover-url').value || null; const status = $('#status').value; const payload = { title: $('#title').value, slug: $('#slug').value, excerpt: $('#excerpt').value, category: $('#category').value || null, body, status, published_at: status === 'published' ? new Date().toISOString() : null, cover_image_path: coverUrl }; const id = $('#article-id').value; const result = id ? await supabase.from('articles').update(payload).eq('id', id).eq('author_id', currentUser.id) : await supabase.from('articles').insert({ ...payload, author_id: currentUser.id }); if (result.error) throw result.error; articleMessage.textContent = id ? 'Article updated.' : 'Article saved.'; resetForm(); await loadArticles(); } catch (error) { articleMessage.textContent = error.message; } });
      resetForm(); supabase.auth.onAuthStateChange((_event, session) => showSession(session)); const { data: { session } } = await supabase.auth.getSession(); await showSession(session);
    </script>
  </body>
</html>
