---
import Layout from '../../layouts/Layout.astro';
import { bodyBlocks, getPublishedArticle, nodeText } from '../../lib/articles';

const { slug } = Astro.params;
const article = slug ? await getPublishedArticle(slug) : null;
if (!article) Astro.response.status = 404;
const blocks = article ? bodyBlocks(article.body) : [];
---

<Layout title={article ? `${article.title} — Andreas Andreou` : 'Article not found'} description={article?.excerpt || 'Article by Andreas Andreou.'}>
  {article ? (
    <>
      <section class="section wrap article-hero">
        <span class="eyebrow">{article.category || 'Article'}</span>
        <h1>{article.title}</h1>
        {article.excerpt && <p class="lede">{article.excerpt}</p>}
        {article.published_at && <p class="article-date">{new Date(article.published_at).toLocaleDateString('en-GB', { dateStyle: 'long' })}</p>}
      </section>
      {article.cover_image_path && <img class="article-cover" src={article.cover_image_path} alt="" />}
      <article class="prose article-prose">
        {blocks.length ? blocks.map((block) => <p>{nodeText(block)}</p>) : <p class="muted">This article has no body content yet.</p>}
      </article>
    </>
  ) : (
    <section class="section wrap"><h1>Article not found</h1><a class="text-link" href="/articles">Back to articles</a></section>
  )}
</Layout>
