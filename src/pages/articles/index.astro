---
import Layout from '../../layouts/Layout.astro';
import { getPublishedArticles } from '../../lib/articles';

const articles = await getPublishedArticles();
---

<Layout title="Articles — Andreas Andreou" description="Articles and working ideas on law, public institutions, procurement and technology.">
  <section class="section wrap articles-hero">
    <span class="eyebrow">Articles</span>
    <h1>Questions worth staying with.</h1>
    <p class="lede">Notes on law, institutions, procurement and the practical work of making complex systems more useful.</p>
  </section>
  <section class="section wrap">
    {articles.length ? (
      <div class="article-grid">
        {articles.map((article) => (
          <article class="article-card">
            {article.cover_image_path && <img src={article.cover_image_path} alt="" loading="lazy" />}
            <div class="article-card-copy">
              <span class="eyebrow">{article.category || 'Article'}</span>
              <h2><a href={`/articles/${article.slug}`}>{article.title}</a></h2>
              {article.excerpt && <p>{article.excerpt}</p>}
              <a class="text-link" href={`/articles/${article.slug}`}>Read article ↗</a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="muted">No articles have been published yet.</p>
    )}
  </section>
</Layout>
