---
import Layout from '../layouts/Layout.astro';
import { getPublishedArticles } from '../lib/articles';
import { contentArray, contentText, getPublishedSiteContent } from '../lib/siteContent';

const articles = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ? await getPublishedArticles() : [];
const featuredArticles = articles.slice(0, 3);
const content = await getPublishedSiteContent();
const expertiseCards = contentArray<{ number: string; title: string; body: string }>(content, 'home.expertise.cards');
const expertiseCategories = contentArray<string>(content, 'home.expertise.category_line');
const serviceItems = contentArray<string>(content, 'home.services.items');
const heroHeadline = contentText(content, 'home.hero.headline');
---

<Layout
  title={contentText(content, 'seo.home.title')}
  description={contentText(content, 'seo.home.description')}
>
  <div class="v16-home" id="top">
    <section class="v16-hero">
      <div class="v16-hero-art" aria-hidden="true">
        <img src="/assets/local-field.png" alt="" />
      </div>
      <div class="v16-hero-copy">
        <h1>{heroHeadline}</h1>
        <div class="v16-actions">
          <a class="v16-action" href={contentText(content, 'home.hero.explore_href')}>{contentText(content, 'home.hero.explore_label')} <span>↘</span></a>
        </div>
      </div>
    </section>

    <section class="v16-about" id="bio">
      <div class="v16-about-grid">
        <figure>
          <img src="/assets/andreas-europe-parliament-enhanced.png" alt={contentText(content, 'home.about.image_alt')} />
          <figcaption>{contentText(content, 'home.about.image_caption')}</figcaption>
        </figure>
        <div class="v16-about-copy">
          <p class="eyebrow">{contentText(content, 'home.about.eyebrow')}</p>
          <p class="v16-about-intro">{contentText(content, 'home.about.intro')}</p>
          <p>{contentText(content, 'home.about.practice')}</p>
          <p>{contentText(content, 'home.about.public_role')}</p>
          <a class="v16-button" href="/bio">{contentText(content, 'home.about.button_label')} <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="v16-section v16-expertise" id="expertise">
      <div class="v16-section-intro">
        <p class="eyebrow">{contentText(content, 'home.expertise.eyebrow')}</p>
        <h2>{contentText(content, 'home.expertise.title')}</h2>
        <p class="v16-category-line">{expertiseCategories.map((category, index) => <>{index > 0 && <i></i>}{category}</>)}</p>
      </div>
      <div class="v16-expertise-body">
        <figure class="v16-expertise-visual">
          <img src="/assets/expertise-digital-mark.png" alt="Abstract four-part mark representing the four areas of expertise" />
        </figure>
        <div class="v16-expertise-grid">
          {expertiseCards.map((card) => <article><span>{card.number}</span><div><h3>{card.title}</h3><p>{card.body}</p></div></article>)}
        </div>
      </div>
      <div class="v16-work-services">
        <p class="eyebrow">{contentText(content, 'home.services.eyebrow')}</p>
        <ul class="v16-services-list">
          {serviceItems.map((item) => <li>{item} <span>↗</span></li>)}
        </ul>
      </div>
    </section>

    <section class="v16-split v16-public-contribution">
      <article id="public-contribution">
        <p class="eyebrow">{contentText(content, 'home.public_contribution.eyebrow')}</p>
        <h2>{contentText(content, 'home.public_contribution.title')}</h2>
        <p>{contentText(content, 'home.public_contribution.body')}</p>
        <a class="v16-action" href="/public-contribution">See my public contribution <span>↗</span></a>
      </article>
    </section>

    <section class="v16-procura" id="services">
      <a class="v16-procura-mark" href="https://www.procura.gr/" target="_blank" rel="noreferrer" aria-label="Visit Procura">
        <span class="procura-wordmark">Procura</span>
        <span class="procura-caption">public procurement<br />research platform</span>
      </a>
      <div>
        <p class="eyebrow">{contentText(content, 'home.procura.eyebrow')}</p>
        <h2>{contentText(content, 'home.procura.title')}</h2>
        <p>{contentText(content, 'home.procura.body')}</p>
        <a class="v16-action" href="https://www.procura.gr/" target="_blank" rel="noreferrer">{contentText(content, 'home.procura.action_label')} <span>↗</span></a>
      </div>
    </section>

    <section class="v16-section v16-notes" id="notes">
      <div class="v16-notes-heading">
        <div><p class="eyebrow">{contentText(content, 'home.notes.eyebrow')}</p><h2>{contentText(content, 'home.notes.title')}</h2></div>
        <a class="v16-action" href="/articles">{contentText(content, 'home.notes.view_all_label')} <span>↗</span></a>
      </div>
      <div class="v16-notes-list">
        {featuredArticles.length ? featuredArticles.map((article) => (
          <article>
            <p>{article.category || 'Article'}</p>
            <h3><a href={`/articles/${article.slug}`}>{article.title}</a></h3>
            <span>Read article ↗</span>
          </article>
        )) : (
          <article><p>Coming soon</p><h3>Recent thinking and updates.</h3><span>Notes will appear here.</span></article>
        )}
      </div>
    </section>

    <section class="v16-closing" id="contact">
      <p class="eyebrow">{contentText(content, 'home.closing.eyebrow')}</p>
      <h2>{contentText(content, 'home.closing.title')}</h2>
      <a class="v16-button" href="mailto:andreoulegal@gmail.com">{contentText(content, 'home.closing.button_label')} <span>↗</span></a>
    </section>
  </div>
</Layout>
